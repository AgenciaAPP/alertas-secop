# Microsoft Graph / Azure App Registration (mismo que usa STC)
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# SharePoint - sitio raíz Agencia APP
SITE_ID=agenciaappgovco.sharepoint.com,a662251b-57ef-4b30-b54e-a3f9637148ef,4e870e4f-6bd2-43d8-ac53-a17823b6c025
LIST_ID_TE_SERVIDORES=f4eb9e0f-3223-41e8-b28e-12ef05e6c915
LIST_ID_CONFIG_ALERTAS=dd3181bf-4920-487b-81aa-33a8e0ab3882

# Secreto para proteger el endpoint de cron (Vercel lo envía automáticamente
# como header Authorization: Bearer <CRON_SECRET> cuando esta variable existe
# en el proyecto). Genera un valor aleatorio largo, ej. con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Contraseña para el panel de administración (/admin)
ADMIN_PASSWORD=

# URL del logo institucional de Agencia APP (imagen hospedada, ej. PNG/SVG público)
LOGO_URL=

# Opcional: correo que recibe copia oculta (BCC) de cada alerta real enviada,
# para hacer seguimiento de que sí se están enviando. Déjala vacía si no la usas.
COPIA_SEGUIMIENTO=

# Opcional: mapa JSON de corrección de cédulas mal digitadas en SECOP.
# Formato: {"cedula_mal_en_secop": "cedula_correcta_en_TE_Servidores"}
CORRECCION_CEDULAS=
